# Copy this file to `.env` and fill in your real key.
# NEVER commit the real .env file — it is listed in .gitignore.
API_KEY=your_key_here

# Optional: base URL for an OpenAI-compatible endpoint (Groq, Ollama, etc.)
# API_BASE_URL=https://api.openai.com/v1

# Optional: override the model your course environment provides.
# API_MODEL=YOUR_MODEL
