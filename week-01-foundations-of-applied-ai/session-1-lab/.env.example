# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in ONE provider below.
# Never commit your real .env file.  (.env is already in .gitignore)
# ---------------------------------------------------------------------------

# OPTION A — Groq (recommended for class: free, no credit card, fast)
#   1. Sign up at https://console.groq.com  ->  API Keys  ->  Create key
#   2. Paste the key below and keep BASE_URL/MODEL as-is.
LLM_API_KEY=your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=deepseek/deepseek-v4-flash:free

# OPTION B — OpenAI (if your account has credits)
#   LLM_API_KEY=sk-your-openai-key
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# OPTION C — Local via Ollama (no internet, no key; run `ollama serve` first)
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
